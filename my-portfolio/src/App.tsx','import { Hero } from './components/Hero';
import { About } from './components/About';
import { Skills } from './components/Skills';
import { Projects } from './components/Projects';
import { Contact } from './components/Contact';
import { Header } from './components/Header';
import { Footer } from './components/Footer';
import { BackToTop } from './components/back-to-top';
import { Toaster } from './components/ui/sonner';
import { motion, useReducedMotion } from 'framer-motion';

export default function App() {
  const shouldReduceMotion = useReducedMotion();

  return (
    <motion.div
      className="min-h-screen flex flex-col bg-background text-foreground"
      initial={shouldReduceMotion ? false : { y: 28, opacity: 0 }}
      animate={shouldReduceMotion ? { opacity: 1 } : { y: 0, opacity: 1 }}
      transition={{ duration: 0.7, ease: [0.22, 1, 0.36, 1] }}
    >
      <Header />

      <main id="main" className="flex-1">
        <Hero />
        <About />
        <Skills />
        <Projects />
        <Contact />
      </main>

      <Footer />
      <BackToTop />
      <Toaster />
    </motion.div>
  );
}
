@import "tailwindcss";
@import "tw-animate-css";

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap');

@theme {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-input-background: var(--input-background);
  --color-ring: var(--ring);
  --color-chart-1: var(--chart-1);
  --color-chart-2: var(--chart-2);
  --color-chart-3: var(--chart-3);
  --color-chart-4: var(--chart-4);
  --color-chart-5: var(--chart-5);
  --color-sidebar: var(--sidebar);
  --color-sidebar-foreground: var(--sidebar-foreground);
  --color-sidebar-primary: var(--sidebar-primary);
  --color-sidebar-primary-foreground: var(--sidebar-primary-foreground);
  --color-sidebar-accent: var(--sidebar-accent);
  --color-sidebar-accent-foreground: var(--sidebar-accent-foreground);
  --color-sidebar-border: var(--sidebar-border);
  --color-sidebar-ring: var(--sidebar-ring);
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
}

:root {
  --font-size: 16px;
  --background: #f5f7ff;
  --foreground: #0b1220;
  --card: rgba(255, 255, 255, 0.76);
  --card-foreground: #0b1220;
  --popover: #ffffff;
  --popover-foreground: #0b1220;
  --primary: #4f46e5;
  --primary-foreground: #ffffff;
  --secondary: #eef2ff;
  --secondary-foreground: #312e81;
  --muted: #eef2f7;
  --muted-foreground: #52607a;
  --accent: #14b8a6;
  --accent-foreground: #ffffff;
  --destructive: #ef4444;
  --destructive-foreground: #ffffff;
  --border: rgba(15, 23, 42, 0.08);
  --input: rgba(255, 255, 255, 0.8);
  --input-background: rgba(255, 255, 255, 0.7);
  --switch-background: #dfe7ff;
  --font-weight-medium: 500;
  --font-weight-normal: 400;
  --ring: #4f46e5;
  --chart-1: #4f46e5;
  --chart-2: #22c55e;
  --chart-3: #f97316;
  --chart-4: #ec4899;
  --chart-5: #38bdf8;
  --radius: 1rem;
  --sidebar: #f8faff;
  --sidebar-foreground: #0b1220;
  --sidebar-primary: #4f46e5;
  --sidebar-primary-foreground: #ffffff;
  --sidebar-accent: #edf2ff;
  --sidebar-accent-foreground: #0b1220;
  --sidebar-border: rgba(15, 23, 42, 0.08);
  --sidebar-ring: #4f46e5;

  --text-base: 1rem;
  --text-lg: 1.125rem;
  --text-xl: 1.25rem;
  --text-2xl: clamp(2.4rem, 5vw, 4.8rem);

  --shadow-soft: 0 24px 80px rgba(79, 70, 229, 0.12);
  --shadow-card: 0 18px 45px rgba(15, 23, 42, 0.08);
  --shadow-glow: 0 20px 60px rgba(79, 70, 229, 0.25);
}

.dark {
  --background: #0a1020;
  --foreground: #f8fafc;
  --card: rgba(15, 23, 42, 0.8);
  --card-foreground: #f8fafc;
  --popover: #0f172a;
  --popover-foreground: #f8fafc;
  --primary: #8b5cf6;
  --primary-foreground: #f8fafc;
  --secondary: #1e293b;
  --secondary-foreground: #dbeafe;
  --muted: #111827;
  --muted-foreground: #a5b4cf;
  --accent: #2dd4bf;
  --accent-foreground: #06131e;
  --destructive: #f87171;
  --destructive-foreground: #ffffff;
  --border: rgba(148, 163, 184, 0.12);
  --input: rgba(15, 23, 42, 0.8);
  --ring: #8b5cf6;
  --chart-1: #8b5cf6;
  --chart-2: #22c55e;
  --chart-3: #f97316;
  --chart-4: #ec4899;
  --chart-5: #38bdf8;
  --sidebar: #0f172a;
  --sidebar-foreground: #f8fafc;
  --sidebar-primary: #8b5cf6;
  --sidebar-primary-foreground: #f8fafc;
  --sidebar-accent: #1e293b;
  --sidebar-accent-foreground: #f8fafc;
  --sidebar-border: rgba(148, 163, 184, 0.12);
  --sidebar-ring: #8b5cf6;
}

html {
  font-size: var(--font-size);
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  margin: 0;
  font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  background:
    radial-gradient(circle at top left, rgba(79, 70, 229, 0.18), transparent 32%),
    radial-gradient(circle at top right, rgba(14, 165, 233, 0.12), transparent 28%),
    var(--background);
  color: var(--foreground);
  line-height: 1.6;
  min-height: 100vh;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

@layer base {
  *, *::before, *::after {
    box-sizing: border-box;
    border-color: var(--border);
    outline-color: color-mix(in srgb, var(--ring) 50%, transparent);
  }

  html {
    font-size: var(--font-size);
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
    background: var(--background);
    color: var(--foreground);
    line-height: 1.6;
  }

  h1 { font-size: var(--text-2xl); font-weight: 800; margin: 0 0 0.5rem; }
  h2 { font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; margin: 0 0 0.5rem; }
  h3 { font-size: clamp(1.1rem, 2vw, 1.5rem); font-weight: 700; margin: 0 0 0.5rem; }
  p { font-size: var(--text-base); margin: 0 0 1rem; color: var(--muted-foreground); }

  a {
    color: inherit;
    text-decoration: none;
    transition: color 160ms ease, opacity 160ms ease, transform 160ms ease;
  }

  .container {
    width: min(1200px, calc(100% - 2rem));
    margin-inline: auto;
    position: relative;
    z-index: 10;
  }

  :focus { outline: none; }
  :focus-visible {
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--ring) 25%, transparent);
    border-radius: 12px;
  }

  .card {
    background: var(--card);
    color: var(--card-foreground);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: 1rem;
  }
}

:where(:not(:has([class*=' text-']), :not(:has([class^='text-'])))) {
  h1 { font-size: var(--text-2xl); font-weight: 800; line-height: 1.05; }
  h2 { font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; line-height: 1.1; }
  h3 { font-size: clamp(1.1rem, 2vw, 1.5rem); font-weight: 700; line-height: 1.25; }
  h4 { font-size: var(--text-base); font-weight: 700; line-height: 1.4; }
  p { font-size: var(--text-base); font-weight: 400; line-height: 1.7; }
  label { font-size: var(--text-base); font-weight: 600; line-height: 1.5; }
  button { font-size: var(--text-base); font-weight: 600; line-height: 1.5; }
  input, textarea { font-size: var(--text-base); font-weight: 400; line-height: 1.5; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

.sr-only {
  position: absolute !important;
  width: 1px; height: 1px;
  padding: 0; margin: -1px; overflow: hidden;
  clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
}

.center { display: flex; align-items: center; justify-content: center; }
section[id] { scroll-margin-top: 90px; }

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  border-bottom: 1px solid rgba(148, 163, 184, 0.12);
  background: rgba(245, 247, 255, 0.72);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: 0 10px 35px rgba(15, 23, 42, 0.04);
  transition: all 180ms ease;
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 78px;
  gap: 1rem;
}

.brand {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  color: #0f172a;
  font-weight: 800;
  letter-spacing: -0.06em;
  font-size: 1.08rem;
}

.brand::before {
  content: "";
  width: 10px;
  height: 10px;
  border-radius: 999px;
  background: linear-gradient(135deg, #4f46e5, #22d3ee);
  box-shadow: 0 0 0 6px rgba(79, 70, 229, 0.12);
}

.header-nav {
  display: none;
  align-items: center;
  gap: 0.5rem;
}

.header-link {
  position: relative;
  display: inline-flex;
  align-items: center;
  padding: 0.6rem 0.8rem;
  border-radius: 999px;
  font-size: 0.94rem;
  color: #475569;
  font-weight: 600;
  transition: all 180ms ease;
}

.header-link:hover,
.header-link:focus-visible {
  color: #0f172a;
  background: rgba(79, 70, 229, 0.06);
}

.header-link-active {
  color: #111827 !important;
  background: rgba(79, 70, 229, 0.08);
  box-shadow: inset 0 0 0 1px rgba(79, 70, 229, 0.1);
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.header-mobile-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 14px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  background: rgba(255, 255, 255, 0.7);
  color: #0f172a;
  transition: all 180ms ease;
  cursor: pointer;
}

.header-mobile-toggle:hover {
  background: rgba(79, 70, 229, 0.08);
  transform: translateY(-1px);
}

.mobile-menu {
  display: grid;
  gap: 0.5rem;
  padding: 0.8rem 0 1rem;
  border-top: 1px solid rgba(148, 163, 184, 0.12);
}

.mobile-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 0.8rem 0.9rem;
  border-radius: 14px;
  background: rgba(15, 23, 42, 0.02);
  color: #1e293b;
  font-weight: 600;
}

.mobile-link:hover {
  background: rgba(79, 70, 229, 0.06);
  color: #111827;
}

@media (min-width: 768px) {
  .header-nav { display: inline-flex; }
  .header-mobile-toggle { display: none; }
  .mobile-menu { display: none; }
}

.hero {
  position: relative;
  overflow: hidden;
  min-height: 92vh;
  padding: 4.5rem 0 3rem;
  background:
    radial-gradient(circle at 15% 20%, rgba(59, 130, 246, 0.12), transparent 22%),
    radial-gradient(circle at 80% 10%, rgba(168, 85, 247, 0.14), transparent 20%),
    linear-gradient(180deg, rgba(255,255,255,0.6) 0%, rgba(245,247,255,0.9) 100%);
}

.hero-radial {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at center, rgba(79, 70, 229, 0.08), transparent 58%);
  pointer-events: none;
}

.hero-orbs { position:absolute; inset:0; pointer-events:none; }
.orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(50px);
  opacity: 0.5;
}
.orb-blue { width: 20rem; height: 20rem; background: rgba(79, 70, 229, 0.18); }
.orb-purple { width: 20rem; height: 20rem; background: rgba(168, 85, 247, 0.18); }
.orb-cyan { width: 16rem; height: 16rem; background: rgba(34, 211, 238, 0.14); }

.accent-orb {
  position:absolute;
  border-radius: 50%;
  filter: blur(55px);
  opacity: 0.32;
  pointer-events: none;
}
.accent-cyan { width: 22rem; height: 22rem; background: rgba(56, 189, 248, 0.18); top: 8%; left: 10%; }
.accent-fuchsia { width: 26rem; height: 26rem; background: rgba(168, 85, 247, 0.16); right: 4%; bottom: 4%; }

.hero-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2.5rem;
  width: 100%;
  flex-direction: column;
}

@media (min-width: 1024px) {
  .hero-row { flex-direction: row; }
}

.hero-left {
  flex: 1 1 0;
  max-width: 650px;
  position: relative;
  z-index: 2;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.55rem 0.9rem;
  border-radius: 999px;
  background: rgba(79, 70, 229, 0.08);
  color: #312e81;
  border: 1px solid rgba(79, 70, 229, 0.12);
  font-weight: 700;
  letter-spacing: 0.02em;
}

.hero-title {
  margin-top: 1rem;
  font-size: clamp(3.1rem, 8vw, 6.2rem);
  line-height: 0.92;
  letter-spacing: -0.08em;
  color: #0f172a;
  font-weight: 900;
  text-wrap: balance;
}

.hero-title .cursor {
  display: inline-block;
  margin-left: 0.08em;
  color: #4f46e5;
  animation: blink 1s steps(1) infinite;
}

@keyframes blink {
  0%, 49% { opacity: 1; }
  50%, 100% { opacity: 0; }
}

.hero-subtitle {
  margin-top: 1.25rem;
  font-size: clamp(1.05rem, 2vw, 1.45rem);
  color: #4f46e5;
  font-weight: 700;
}

.hero-lead {
  margin-top: 0.75rem;
  max-width: 62ch;
  font-size: 1.02rem;
  color: #475569;
}

.hero-ctas {
  margin-top: 1.5rem;
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  padding: 0.85rem 1.5rem;
  border-radius: 999px;
  border: none;
  font-weight: 700;
  cursor: pointer;
  transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease, color 180ms ease;
}

.btn:hover {
  transform: translateY(-2px);
}

.btn-primary {
  color: #fff;
  background: linear-gradient(135deg, #4f46e5, #06b6d4);
  box-shadow: var(--shadow-glow);
}

.btn-primary:hover {
  box-shadow: 0 20px 35px rgba(79, 70, 229, 0.28);
}

.btn-outline {
  color: #0f172a;
  background: rgba(255,255,255,0.8);
  border: 1px solid rgba(79, 70, 229, 0.12);
  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.5);
}

.social-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-top: 1.25rem;
}

.social-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 14px;
  background: rgba(255,255,255,0.75);
  border: 1px solid rgba(148, 163, 184, 0.18);
  color: #312e81;
  transition: all 180ms ease;
}

.social-link:hover {
  color: #4f46e5;
  transform: translateY(-3px);
  box-shadow: 0 18px 28px rgba(79, 70, 229, 0.12);
}

.hero-right {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 0;
}

.avatar-ring {
  position: relative;
  width: min(78vw, 420px);
  aspect-ratio: 1;
  border-radius: 32% 68% 52% 48% / 40% 40% 60% 60%;
  padding: 10px;
  background: linear-gradient(135deg, rgba(79, 70, 229, 0.98), rgba(34, 211, 238, 0.8), rgba(168, 85, 247, 0.75));
  box-shadow: var(--shadow-soft);
  animation: float 8s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-12px) rotate(2deg); }
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 32% 68% 52% 48% / 40% 40% 60% 60%;
  overflow: hidden;
  border: 5px solid rgba(255,255,255,0.7);
}

.avatar-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.avatar-emoji {
  font-size: clamp(2.5rem, 7vw, 5rem);
}

.cta-row-sm {
  display: flex;
  justify-content: center;
  gap: 0.9rem;
  margin-top: 1.25rem;
  flex-wrap: wrap;
}

@media (min-width: 1024px) {
  .cta-row-sm { display: none; }
}

.social-row-lg {
  display: none;
  justify-content: center;
  gap: 0.95rem;
  margin-top: 1.5rem;
}

@media (min-width: 1024px) {
  .social-row-lg { display: flex; }
}

.social-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 14px;
  background: rgba(255,255,255,0.75);
  border: 1px solid rgba(148,163,184,0.12);
  color: #312e81;
}

.scroll-indicator {
  position: absolute;
  left: 50%;
  bottom: 1.2rem;
  transform: translateX(-50%);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 999px;
  background: rgba(255,255,255,0.8);
  color: #312e81;
  border: 1px solid rgba(79,70,229,0.12);
  box-shadow: 0 8px 22px rgba(15,23,42,0.08);
  cursor: pointer;
}

.about-section,
.skills-section,
.projects-section,
.contact-section {
  position: relative;
  z-index: 1;
}

.about-section {
  padding: 6rem 0;
  background: linear-gradient(180deg, rgba(255,255,255,0.8) 0%, rgba(245,247,255,0.85) 100%);
}

.about-header,
.skills-header,
.projects-header,
.contact-header {
  text-align: center;
  max-width: 760px;
  margin: 0 auto 2.5rem;
}

.about-title,
.skills-title,
.projects-title,
.contact-title {
  margin-bottom: 0.8rem;
  letter-spacing: -0.06em;
  font-weight: 800;
  background: linear-gradient(135deg, #0f172a, #4f46e5 32%, #14b8a6 72%, #7c3aed 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.about-lead,
.skills-lead,
.projects-lead,
.contact-lead {
  font-size: 1.03rem;
  color: #475569;
  max-width: 60ch;
  margin-inline: auto;
}

.features-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.15rem;
}

@media (min-width: 640px) {
  .features-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (min-width: 1024px) {
  .features-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
}

.feature-card {
  min-height: 100%;
  padding: 1.5rem 1.4rem;
  border: 1px solid rgba(148, 163, 184, 0.12);
  background: rgba(255,255,255,0.8);
  box-shadow: var(--shadow-card);
  transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
}

.feature-card:hover {
  transform: translateY(-8px);
  border-color: rgba(79, 70, 229, 0.22);
  box-shadow: 0 26px 55px rgba(79, 70, 229, 0.12);
}

.feature-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 58px;
  height: 58px;
  border-radius: 16px;
  background: linear-gradient(135deg, rgba(79, 70, 229, 0.12), rgba(34, 211, 238, 0.12));
  color: #312e81;
}

.feature-icon-svg { width: 27px; height: 27px; }

.feature-title {
  margin-top: 1rem;
  color: #0f172a;
  font-size: 1.12rem;
}

.feature-desc {
  margin-top: 0.45rem;
  color: #475569;
}

.skills-section {
  padding: 5.5rem 0;
  background: linear-gradient(180deg, rgba(245,247,255,0.7) 0%, rgba(255,255,255,0.85) 100%);
}

.skills-container {
  width: min(1200px, calc(100% - 2rem));
  margin-inline: auto;
}

.skills-tabs-list {
  background: rgba(255,255,255,0.7);
  border: 1px solid rgba(148, 163, 184, 0.12);
  box-shadow: 0 10px 24px rgba(15, 23, 42, 0.04);
  border-radius: 999px;
  padding: 0.3rem;
  overflow-x: auto;
}

.skills-tabs-trigger {
  border-radius: 999px;
  color: #475569;
  font-weight: 600;
  padding: 0.7rem 1rem;
}

.skills-tabs-trigger[data-state='active'] {
  background: linear-gradient(135deg, #4f46e5, #06b6d4);
  color: white;
  box-shadow: 0 10px 24px rgba(79, 70, 229, 0.25);
}

.skills-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.15rem;
  margin-top: 1.75rem;
}

@media (min-width: 768px) {
  .skills-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (min-width: 1200px) {
  .skills-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
}

.skills-category {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  min-height: 100%;
  padding: 1.45rem;
  border-radius: 22px;
  border: 1px solid rgba(148, 163, 184, 0.12);
  background: rgba(255,255,255,0.7);
  box-shadow: var(--shadow-card);
  transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
}

.skills-category:hover {
  transform: translateY(-6px);
  border-color: rgba(79,70,229,0.18);
  box-shadow: 0 22px 40px rgba(79,70,229,0.12);
}

.skills-category-title {
  color: #0f172a;
  font-size: 1.08rem;
}

.skills-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 0.55rem;
}

.skill-badge-wrap {
  display: inline-block;
}

.skill-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  padding: 0.5rem 0.75rem;
  background: rgba(79,70,229,0.08);
  color: #312e81;
  border: 1px solid rgba(79,70,229,0.12);
  font-size: 0.82rem;
  font-weight: 700;
}

.projects-section {
  padding: 5.5rem 0;
  background: linear-gradient(180deg, rgba(255,255,255,1) 0%, rgba(245,247,255,0.75) 100%);
}

.projects-container {
  width: min(1200px, calc(100% - 2rem));
  margin-inline: auto;
}

.projects-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.2rem;
}

@media (min-width: 768px) {
  .projects-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
}

@media (min-width: 1200px) {
  .projects-grid { grid-template-columns: repeat(3, minmax(0,1fr)); }
}

.project-card {
  height: 100%;
  overflow: hidden;
  border: 1px solid rgba(148,163,184,0.12);
  background: rgba(255,255,255,0.8);
  box-shadow: var(--shadow-card);
  transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
}

.project-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 26px 55px rgba(79,70,229,0.12);
  border-color: rgba(79,70,229,0.18);
}

.project-media {
  position: relative;
  height: 220px;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(79, 70, 229, 0.08), rgba(34, 211, 238, 0.04));
}

.project-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 220ms ease;
}

.project-card:hover .project-image {
  transform: scale(1.06);
}

.project-media-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.04), rgba(79,70,229,0.08));
}

.project-body {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  padding: 1.4rem;
}

.project-title {
  color: #0f172a;
}

.project-desc {
  color: #475569;
  font-size: 0.95rem;
}

.project-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: auto;
}

.project-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.35rem 0.7rem;
  border-radius: 999px;
  background: rgba(79,70,229,0.08);
  border: 1px solid rgba(79,70,229,0.12);
  color: #312e81;
  font-size: 0.75rem;
  font-weight: 700;
}

.project-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.7rem;
  margin-top: 0.35rem;
}

.contact-section {
  padding: 5.5rem 0 6rem;
  background: linear-gradient(180deg, rgba(245,247,255,0.7) 0%, rgba(255,255,255,1) 100%);
}

.contact-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.contact-bg-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(60px);
  opacity: 0.25;
}

.contact-bg-orb-blue { width: 22rem; height: 22rem; background: rgba(79,70,229,0.18); left: 6%; top: 20%; }
.contact-bg-orb-purple { width: 26rem; height: 26rem; background: rgba(168,85,247,0.18); right: 8%; bottom: 12%; }

.contact-inner {
  width: min(1200px, calc(100% - 2rem));
  margin-inline: auto;
  position: relative;
  z-index: 2;
}

.contact-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.2rem;
}

@media (min-width: 920px) {
  .contact-grid { grid-template-columns: 1fr 1fr; }
}

.contact-column {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.contact-card {
  padding: 1.4rem;
  border-radius: 24px;
  border: 1px solid rgba(148,163,184,0.12);
  background: rgba(255,255,255,0.75);
  box-shadow: var(--shadow-card);
}

.contact-subsection {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
}

.contact-section-title {
  color: #0f172a;
  font-size: 1.08rem;
}

.contact-subtitle {
  color: #475569;
  font-size: 0.95rem;
}

.contact-actions {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.contact-note {
  color: #64748b;
  font-size: 0.88rem;
}

.contact-info-list {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.contact-card-inner {
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

.contact-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border-radius: 14px;
  background: linear-gradient(135deg, rgba(79,70,229,0.12), rgba(34,211,238,0.12));
  color: #312e81;
}

.contact-icon-svg { width: 21px; height: 21px; }

.contact-text {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.contact-info-title {
  color: #0f172a;
  font-weight: 700;
  margin: 0;
}

.contact-info-link,
.contact-info-value {
  color: #312e81;
  font-weight: 600;
  margin: 0;
}

.contact-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.form-row {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.form-label {
  color: #0f172a;
  font-weight: 700;
}

.input-default,
.textarea-default {
  width: 100%;
  border: 1px solid rgba(148,163,184,0.18);
  border-radius: 16px;
  padding: 0.8rem 0.9rem;
  background: rgba(255,255,255,0.8);
  color: #0f172a;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.5);
}

.input-default:focus,
.textarea-default:focus {
  border-color: rgba(79,70,229,0.45);
  box-shadow: 0 0 0 4px rgba(79,70,229,0.08);
}

.textarea-default {
  resize: vertical;
  min-height: 140px;
}

.site-footer {
  border-top: 1px solid rgba(148,163,184,0.12);
  background: rgba(255,255,255,0.75);
  backdrop-filter: blur(8px);
}

.footer-inner {
  width: min(1200px, calc(100% - 2rem));
  margin-inline: auto;
  padding: 1.25rem 0 2rem;
}

.footer-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.8rem;
  flex-wrap: wrap;
}

.footer-left {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  color: #475569;
}

.footer-copy {
  color: #475569;
}

.icon-heart {
  width: 15px;
  height: 15px;
  color: #ef4444;
}

.footer-socials {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.dialog-project {
  border-radius: 24px !important;
  border: 1px solid rgba(148,163,184,0.12) !important;
  background: rgba(255,255,255,0.9) !important;
}

.dialog-project-image {
  width: 100%;
  height: 220px;
  border-radius: 16px;
  object-fit: cover;
}

.dialog-project-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

@media (max-width: 767px) {
  .hero {
    padding-top: 3.5rem;
  }

  .header-inner {
    min-height: 72px;
  }

  .brand {
    font-size: 1rem;
  }

  .project-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .project-actions > * {
    width: 100%;
  }

  .btn {
    width: 100%;
  }

  .contact-actions {
    flex-direction: column;
    align-items: stretch;
  }
}
